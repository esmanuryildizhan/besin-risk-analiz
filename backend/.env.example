# Bu dosyayı kopyalayıp adını .env yapın:  cp .env.example .env
# .env dosyası depoya GİRMEZ (.gitignore'da) — içinde şifre olduğu için.

# PostgreSQL bağlantısı.
# Biçim: postgresql://KULLANICI:PAROLA@SUNUCU:PORT/VERITABANI_ADI
# Yereldeyse sunucu localhost, port 5432 olur. Veritabanını elle oluşturmanıza
# gerek yok; `npx prisma migrate dev` yoksa kendisi oluşturur.
DATABASE_URL="postgresql://postgres:parolaniz@localhost:5432/besin_risk"

# Giriş biletlerini (JWT) imzalamak için gizli anahtar.
# UZUN ve RASTGELE olmalı; bu dizeyi bilen biri istediği kullanıcı adına
# bilet üretebilir. Üretmek için (PowerShell):
#   -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 48 | % {[char]$_})
JWT_SECRET="buraya-uzun-ve-rastgele-bir-dize-yazin"

# İSTEĞE BAĞLI — yalnızca yayına alırken gerekir.
# Arayüzün adresi. Tanımlı değilse http://localhost:3000 kabul edilir.
# FRONTEND_URL="https://ornek.vercel.app"
