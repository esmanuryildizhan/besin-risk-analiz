// Besin Risk Analiz Sistemi - veritabanı şeması
// Veri kaynağı: TürKomp, Ulusal Gıda Kompozisyon Veri Tabanı v1.0
// https://turkomp.tarimorman.gov.tr/

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"

  // url: UYGULAMANIN sorguları buradan geçiyor. Yayında HAVUZLANMIŞ
  // (pooled) bağlantı kullanılıyor — sunucu ortamlarında eşzamanlı bağlantı
  // sayısı sınırlı ve havuzlayıcı bunu yönetiyor.
  url = env("DATABASE_URL")

  // directUrl: GÖÇLER buradan geçiyor, havuzlayıcıyı ATLAYARAK.
  //
  // Niye şart: Neon'un havuzlayıcısı (PgBouncer, işlem kipinde) göçlerin
  // ihtiyaç duyduğu oturum düzeyindeki işlemleri desteklemiyor — danışma
  // kilitleri ve hazırlanmış ifadeler gibi. Havuzlanmış bağlantı üzerinden
  // `prisma migrate deploy` çalıştırmak, sebebi anlaşılmayan hatalarla
  // başarısız oluyor.
  //
  // YEREL GELİŞTİRMEDE havuzlayıcı yok; .env dosyasında DIRECT_URL'i
  // DATABASE_URL ile aynı yazmak yeterli.
  directUrl = env("DIRECT_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  surname      String
  email        String   @unique
  passwordHash String
  gender       String?
  /// Seçilen avatar anahtarı ("vanKedisi", "aslan"...). Kişisel veri değil,
  /// şifrelenmiyor: kullanıcının seçtiği bir simge. Veritabanında tutuluyor
  /// ki cihaz değiştirince kaybolmasın.
  avatar       String?
  diet         String?

  // GÜNLÜK HEDEFLER — kullanıcının kendi kararı.
  // Boş bırakılırsa arayüz varsayılan gösteriyor (2000 kcal / 2 L). Bilerek
  // hesaplamıyoruz: boy-kilo-yaştan günlük ihtiyaç tahmin etmek bir sağlık
  // tahminidir ve bu uygulama tıbbi tavsiye vermiyor. Kullanıcı kendi hedefini
  // yazar, biz yalnızca ona göre doluluk gösteririz.
  kcalGoal     Int?
  waterGoalL   Float?

  // KVKK ONAY KAYDI
  // Niye tarih + sürüm birlikte: "onay verdi mi" yetmiyor, "NE ZAMAN ve HANGİ
  // METNE" sorusunun da cevabı gerekiyor. Metin değişip sürüm artarsa mevcut
  // kullanıcıdan yeniden onay isteniyor (src/kvkk_metinleri.js).
  // Aydınlatma ve açık rıza AYRI iki alan: KVKK Kurulu'nun 2026/347 sayılı
  // ilke kararı ikisini ayrı tutmayı zorunlu kılıyor — aydınlatma bir onay
  // değil bilgilendirmedir, beyanı "okudum ve anladım"dır.
  aydinlatmaOkunduAt DateTime?
  acikRizaAt         DateTime?
  rizaSurumu         String?

  // İKİ AŞAMALI DOĞRULAMA (TOTP — RFC 6238)
  //
  // totpSecret: kullanıcıyla paylaşılan gizli anahtar (base32). Telefondaki
  // doğrulayıcı uygulama bu anahtardan ve o anki zamandan 6 haneli kod üretir;
  // sunucu aynı hesabı yapıp karşılaştırır. Kod ağdan HİÇ geçmez — e-posta
  // veya SMS ile kod göndermekten bu yüzden daha güvenli.
  //
  // totpEnabled: anahtar üretilir üretilmez AÇILMIYOR. Kullanıcı QR kodu
  // okutup geçerli bir kod girerek kurulumun çalıştığını kanıtlayana kadar
  // false kalıyor. Aksi hâlde yanlış kurulumda kullanıcı kendi hesabından
  // kilitlenirdi.
  //
  // totpYedekKodlari: telefon kaybedilirse tek kullanımlık kurtarma kodları.
  // bcrypt özeti olarak saklanıyor, düz metin değil.
  totpSecret       String?
  totpEnabled      Boolean  @default(false)
  totpYedekKodlari String[]

  // OTURUMLARI TOPTAN GEÇERSİZ KILMA DAMGASI
  //
  // Niye gerekli: oturum bileti (JWT) imzalı ve durumsuz, yani sunucu onu geri
  // çağıramıyor. Şifre sıfırlandığında saldırganın elindeki bilet süresi
  // dolana kadar çalışmaya devam ederdi — oysa şifre sıfırlamanın asıl amacı
  // davetsiz misafiri dışarı atmak.
  //
  // Çözüm: bu damga. Biletin üretilme anı (iat) bu damgadan ÖNCEYSE bilet
  // reddediliyor. Şifre her değiştiğinde damga güncelleniyor, böylece o andan
  // önce verilmiş TÜM biletler tek hamlede geçersiz oluyor.
  oturumlarGecersizAt DateTime?

  // E-POSTA DOĞRULAMA
  //
  // Niye gerekli: bu alan olmadan herkes BAŞKASININ e-posta adresiyle kayıt
  // olabiliyordu. Sağlık verisi tutan bir uygulamada bu iki yönden kötü —
  // adresin sahibi adına bir hesap açılmış oluyor, ve şifre sıfırlama
  // bağlantısı doğrulanmamış bir adrese gidiyor.
  //
  // Boşsa (null) kullanıcı giriş YAPAMAZ. Doğrulandığı an damgalanıyor.
  ePostaDogrulandiAt DateTime?

  // SAKLAMA VE İMHA (bkz. src/saklama.js)
  //
  // sonGirisAt: hesabın son hareket zamanı. Saklama süresi buradan sayılıyor —
  // kişi uygulamayı kullanmayı bıraktığında veriyi tutmanın amacı da ortadan
  // kalkıyor (KVKK m.4: amaç için gerekli SÜRE KADAR saklama).
  //
  // silmeUyarisiAt: silme uyarısının gönderildiği an. Veri sessizce
  // silinmiyor; uyarı gidiyor, kullanıcı giriş yaparsa hesap kurtuluyor ve
  // bu alan temizleniyor.
  sonGirisAt     DateTime?
  silmeUyarisiAt DateTime?

  // HESAP BAZLI DENEME SAYACI
  //
  // Hız sınırlayıcı IP başına çalışıyor; IP değiştirebilen bir saldırgan tek
  // bir hesabı denemeye devam edebiliyordu. Bu sayaç hesabın kendisine bağlı,
  // yani saldırganın nereden geldiği önemli değil.
  //
  // Başarılı girişte sıfırlanıyor. Eşik aşılınca kilitBitisi doluyor ve o ana
  // kadar şifre doğru olsa bile giriş reddediliyor.
  basarisizGiris Int       @default(0)
  kilitBitisi    DateTime?

  createdAt    DateTime @default(now())

  allergies    UserAllergy[]
  diseases     UserDisease[]
  diaryEntries DiaryEntry[]
  diaryDays    DiaryDay[]
  labResults   LabResult[]
  sifreSifirlamalari PasswordReset[]
  ePostaDogrulamalari EmailVerification[]
}

// E-POSTA DOĞRULAMA BİLETİ
//
// PasswordReset ile aynı tasarım: bilet saklanmıyor, yalnızca SHA-256 özeti.
// Ayrı tablo olmasının sebebi, iki biletin ömrünün ve anlamının farklı olması —
// sıfırlama bileti 60 dakika, doğrulama bileti 24 saat yaşıyor, çünkü kullanıcı
// kayıt postasını ertesi gün açabilir.
model EmailVerification {
  id         Int      @id @default(autoincrement())
  tokenOzeti String   @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime @default(now())

  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ŞİFRE SIFIRLAMA BİLETİ
//
// Niye ayrı tablo: kullanıcı üzerinde tek alan tutsak, aynı anda birden fazla
// istek ya da "eski bileti geçersiz kıl" mantığı takip edilemezdi. Ayrıca
// kullanılmış biletlerin kaydı kalıyor.
//
// tokenOzeti: BİLETİN KENDİSİ SAKLANMIYOR, yalnızca SHA-256 özeti. Veritabanı
// sızsa özetten bilete dönülemediği için kimsenin şifresi sıfırlanamaz.
// Burada bcrypt DEĞİL SHA-256 kullanılıyor: bcrypt'in yavaşlığı insanların
// seçtiği zayıf şifreleri kaba kuvvetten korumak için. Bu bilet 32 baytlık
// rastgele veri, tahmin edilemez; yavaş özete ihtiyacı yok.
model PasswordReset {
  id        Int      @id @default(autoincrement())
  tokenOzeti String  @unique
  // Biletin geçerlilik sonu. Kısa tutuluyor (bkz. SIFIRLAMA_SURESI_DK):
  // e-posta kutusu sonradan ele geçse bile eski bağlantı işe yaramasın.
  expiresAt DateTime
  // Tek kullanımlık: kullanıldığı an damgalanıyor, silinmiyor — "bu bilet
  // zaten kullanılmış" demek, "böyle bir bilet yok" demekten farklı.
  usedAt    DateTime?
  createdAt DateTime @default(now())

  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserAllergy {
  id     Int    @id @default(autoincrement())
  // ŞİFRELİ (KVKK 2018/10). Çözülünce "gluten", "milk", "eggs" gibi anahtarlar
  // çıkıyor — Food.allergens ile aynı sözlük.
  name   String
  userId Int
  user   User   @relation(fields: [userId], references: [id])
}

model UserDisease {
  id     Int    @id @default(autoincrement())
  // ŞİFRELİ (KVKK 2018/10) — kişinin hangi hastalığı olduğu özel nitelikli
  // kişisel veri. Çözülünce "diyabet", "hipertansiyon", "kansizlik" gibi
  // anahtarlar çıkıyor.
  name   String
  userId Int
  user   User   @relation(fields: [userId], references: [id])
}

/// Genel besinler (markasız): pırasa, muz, mercimek, yoğurt...
/// Bütün besin değerleri 100 GRAM içindir. Bilinmeyen değer null kalır, 0 yazılmaz.
model Food {
  id            Int     @id @default(autoincrement())
  /// Kaynak + kimlik: "turkomp:pekmez".
  /// Aynı besin iki kez eklenmesin diye benzersiz.
  externalId    String  @unique
  name          String // Türkçe ad ("Pırasa")
  nameEn        String // Kaynaktaki orijinal ad ("Leeks, (bulb and lower leaf-portion), raw")
  category      String // Sebze, Meyve, Tahıl, Et-Balık, ...
  icon          String?

  // Tipik porsiyon: kullanıcı 100 g değil "1 orta boy muz" yer
  portionName   String // "1 orta boy"
  portionGrams  Float // 118

  // --- Makro besinler (g) ---
  kcal          Float
  proteins      Float
  carbohydrates Float
  sugars        Float?
  fiber         Float?
  fat           Float
  saturatedFat  Float?
  transFat      Float?
  // ÖLÇÜLEN tekli/çoklu doymamış yağ asidi toplamları (TürKomp her sayfada
  // "Yağ asitleri, toplam tekli doymamış" ve "...toplam çoklu doymamış" diye
  // veriyor). Niye eklendi: doymamış yağ oranı eskiden (yağ - doymuş)/yağ ile
  // TAHMİN ediliyordu ve bu oranı FAZLA gösteriyordu — toplam yağ, yağ asidi
  // olmayan kütleyi (gliserol) de içeriyor, üstüne trans yağ da "doymuş değil"
  // sayılıyordu. Fazla tahmin, doymuş yağ uyarısından muafiyeti hak etmeyen
  // besne verebiliyordu; yani yanlış yön. Ölçüm varsa o kullanılıyor.
  monounsaturatedFat Float?
  polyunsaturatedFat Float?
  // Uzun zincirli omega-3 yağ asitleri, GRAM/100 g (TürKomp'un birimi).
  // TürKomp balık sayfalarında "Yağ asidi 20:5 n-3 all-cis" (EPA) ve
  // "Yağ asidi 22:6 n-3 all-cis" (DHA) satırlarında veriliyor.
  // Niye eklendi: balığın tek olumlu tarafı hiç temsil edilmiyordu; lüfer
  // kolesterolde yalnızca doymuş yağ uyarısıyla görünüyor, hiçbir fayda
  // almıyordu. Oysa projenin temel fikri bir besnin aynı hastalıkta hem
  // uyarı hem fayda verebilmesi.
  epa                Float?
  dha                Float?

  /// Glisemik indeks (TürKomp "Glisemik İndeks" satırı, 0-100).
  /// Diyabet kuralı bununla GERÇEK glisemik yükü hesaplıyor:
  ///   glisemik yük = glisemik indeks x porsiyondaki net karbonhidrat / 100
  /// Boşsa motor eski yöntemi kullanır: glisemik indeks en fazla 100
  /// olabileceğinden net karbonhidratın kendisi bir üst sınırdır.
  /// USDA bu değeri hiç raporlamıyordu; TürKomp'a geçmenin kazancı.
  glycemicIndex Float?

  // --- Mineraller ve diğerleri (mg) ---
  cholesterolMg Float?
  sodiumMg      Float?
  potassiumMg   Float?
  calciumMg     Float?
  ironMg        Float?
  magnesiumMg   Float?
  phosphorusMg  Float?
  zincMg        Float?
  vitaminCMg    Float?
  caffeineMg    Float?

  // --- Vitaminler (mikrogram) ---
  vitaminDUg    Float?
  vitaminKUg    Float? // kan sulandırıcı (varfarin) kullananlar için önemli
  folateUg      Float?
  vitaminB12Ug  Float?

  // --- Alerjenler: tipik tarife göre. ["gluten", "milk"] ---
  allergens     String[]
  traces        String[] // eser miktarda bulunma ihtimali (ör. yulafta gluten)

  /// Diyet etiketleri: "et", "balik", "deniz", "yumurta", "sut", "bal"
  /// Vejetaryen/vegan kontrolü bunlara göre yapılır (kategoriye göre değil:
  /// yumurta "Et-Balık" kategorisinde ama vejetaryenler yumurta yiyebilir).
  dietTags      String[]

  /// Verinin kaynağı; arayüzde besin detayında gösteriliyor (TürKomp için atıf zorunlu)
  source        String

  // DiaryEntry ilişkisi KALDIRILDI: besin kimliği artık şifreli (foodRef),
  // dolayısıyla veri tabanı düzeyinde bağ kurulamıyor. Bkz. DiaryEntry.

  @@index([category])
  @@index([name])
}

/// Hastalıklar ve kuralları veritabanında duruyor ki kod değiştirmeden
/// yeni kural eklenebilsin (Prisma Studio'dan bile düzenlenebilir).
model Disease {
  id        Int     @id @default(autoincrement())
  key       String  @unique // "diyabet", "hipertansiyon", ...
  name      String
  icon      String?
  note      String?
  /// false ise: elimizdeki veriyle otomatik değerlendirilemiyor (IBS, gut gibi)
  evaluable Boolean @default(true)

  rules     DiseaseRule[]
}

model DiseaseRule {
  id         Int     @id @default(autoincrement())
  diseaseKey String
  disease    Disease @relation(fields: [diseaseKey], references: [key], onDelete: Cascade)

  nutrient   String?  // "sugars", "sodiumMg", "ironMg", ... (yoksa sadece kategoriye bakılır)
  op         String?  // ">", ">=", "<", "<="
  threshold  Float?
  /// Doluysa kural sadece bu kategorilerde çalışır (ör. ["Hazır Gıda"])
  categories String[]
  basis      String @default("100g") // "100g" | "porsiyon"
  level      String // "RISKLI" | "DIKKAT" | "ONERILIR"
  message    String
  /// true ise: bu değer besinde yoksa "uygun" denmez, DİKKAT verilir
  critical   Boolean @default(false)
  /// Eşiğin kaynağı: hastalik_kurallari.js içindeki KAYNAKLAR tablosunun anahtarı
  /// (ör. "FSA2016", "EVERT2019"). "TAKDIR" = hiçbir makaleye dayanmıyor.
  source     String?
  /// Sayının makalede NEREDE geçtiği + günlük sınırı porsiyona çevirirken
  /// yaptığımız varsayım. Arayüzde "neden?" açıklaması olarak gösterilir.
  sourceNote String?
  /// FSA kılavuzunun kendi kuralı (Annex 3, s.19): porsiyon başına kırmızı
  /// sınırlar yalnızca porsiyonu 100 g'dan büyük ürünlerde uygulanır.
  onlyLargePortion Boolean @default(false)
  /// Lif yoğunluğu muafiyeti (g/1000 kcal). Besnin lif yoğunluğu bu değerin
  /// üstündeyse kural atlanır — Evert 2019 (s.736) kuru baklagilleri, tam
  /// taneli tahılları ve sebzeleri diyabette açıkça önerdiği için.
  exemptFiberDensity Float?
  /// Doymamış yağ oranı muafiyeti (%). Johnson 2023'te doymuş yağı AZALTMA
  /// önerisi zayıf (GRADE 2), doymamışla DEĞİŞTİRME önerisi güçlü (GRADE 1).
  exemptUnsaturatedPct Float?
  /// true ise: besnin glisemik indeksi ölçülmüşse bu kural atlanır. Net
  /// karbonhidrat eşiği glisemik yükü tahmin eden bir vekil; gerçek değer
  /// varsa vekile gerek yok ve ikisi birlikte çift uyarı verir.
  exemptIfGlycemicLoadKnown Boolean @default(false)
  sortOrder  Int    @default(0)

  @@index([diseaseKey])
}

// Bir öğüne eklenen TEK kalem. İki giriş biçimi var ve ikisi de aynı tabloda:
//
//   (a) BESİN SEÇEREK  -> foodRef + amount (gram) dolu. Kalori veri tabanındaki
//       besinden hesaplanır. Bu biçimde o gün yenenler risk motorundan da
//       geçirilebiliyor ("bugün 3 riskli besin yedin").
//   (b) SERBEST GİRİŞ  -> label + kcal dolu, foodRef boş. Dışarıda yenen,
//       veri tabanında olmayan bir yemek için.
//
// kcal HER İKİ DURUMDA da saklanıyor. Besin seçildiğinde de hesaplanıp
// yazılıyor; sonradan hesaplanmıyor. Sebebi: günlük bir GEÇMİŞ KAYDI. TürKomp
// değeri ileride düzeltilirse geçmiş günlerin kalorisi değişmemeli, kullanıcı
// o gün ne yediyse o kalmalı.
model DiaryEntry {
  id       Int      @id @default(autoincrement())
  date     DateTime @db.Date
  mealType String // "kahvalti" | "ogle" | "aksam" | "ara"

  // HEPSİ ŞİFRELİ (AES-256-GCM, bkz. src/kripto.js). Sayısal alanlar bu yüzden
  // String; toplama veritabanında değil JS tarafında yapıldığı için sorun
  // çıkarmıyor.
  //
  // foodRef: ŞİFRELİ besin kimliği. Eskiden `foodId Int?` idi ve Food
  // tablosuna yabancı anahtarla bağlıydı; o hâlde veri tabanı dökümü alan biri
  // kişinin NE YEDİĞİNİ okuyabiliyordu. Beslenme kaydı, hastalık bağlamıyla
  // birleştiğinde kişi hakkında bilgi veren bir veridir; düz metin kalması
  // KVKK m.4 "ölçülülük" ve GDPR m.5(1)(f) "bütünlük ve gizlilik" ilkeleriyle
  // bağdaşmıyordu.
  //
  // BEDELİ, AÇIKÇA: yabancı anahtar kalktı. Veri tabanı artık foodRef'in
  // gerçek bir besne işaret ettiğini garanti etmiyor; bu denetim uygulamaya
  // geçti (besin bulunamazsa kalem "Besin kaydı bulunamadı" diye gösteriliyor,
  // kalori ve gram korunuyor). Şifreli bir değer JOIN'e giremediği için bu
  // kaçınılmazdı: ya bağ ya gizlilik.
  foodRef  String?
  amount   String? // gram — yalnızca besin seçildiğinde
  label    String? // serbest girişin adı ("Dışarıda pide")
  kcal     String // giriş anında hesaplanan/yazılan kalori

  userId   Int
  user     User     @relation(fields: [userId], references: [id])

  @@index([userId, date])
}

// Öğüne bağlı OLMAYAN günlük değerler: yakılan kalori ve su.
// Ayrı tablo çünkü bunlar öğün kalemi değil, günün toplamı. Kullanıcı başına
// gün başına tek satır.
model DiaryDay {
  id         Int      @id @default(autoincrement())
  date       DateTime @db.Date
  // ŞİFRELİ. Varsayılan 0 kaldırıldı: düz metin "0" çözülemezdi.
  // Boş (null) değer okuma tarafında 0 sayılıyor.
  burnedKcal String?
  waterL     String?

  userId     Int
  user       User     @relation(fields: [userId], references: [id])

  @@unique([userId, date])
}

// Bir tahlil sonucu. Değerler kullanıcının PDF'inden geliyor ve YORUM DA
// PDF'ten geliyor: eşik olarak laboratuvarın kendi referans aralığı ve
// kendi sınıflaması kullanılıyor, bizim koyduğumuz bir eşik yok.
// (Karar: 3 Ekim 2026 — bkz. claude/tahlil-ve-makine-ogrenmesi-karari.md)
model LabResult {
  // ŞİFRELİ ALANLAR — KVKK Kurulu 2018/10 sayılı kararı, özel nitelikli
  // kişisel verinin "kriptografik yöntemler kullanılarak muhafaza edilmesini"
  // istiyor. Aşağıdaki alanlar AES-256-GCM ile şifreli saklanıyor
  // (src/kripto.js). Sayısal olanlar da bu yüzden String: şifreli metin
  // sayı değildir.
  //
  // userId ve testDate BİLEREK şifresiz: sorgular onların üzerinden yürüyor
  // ve ikisi tek başına sağlık verisi değil. Şifreli alanda veritabanı
  // araması ve sıralaması yapılamaz.
  id       Int      @id @default(autoincrement())
  testName String   // şifreli
  value    String?  // şifreli sayı; okunamayan sonuçta boş, textValue dolu
  unit     String?  // şifreli
  refLow   String?  // şifreli sayı
  refHigh  String?  // şifreli sayı
  testDate DateTime

  // "< 0,5" gibi sonuçlarda işleç ayrı tutuluyor: 0,5 ile "0,5'ten küçük"
  // aynı şey değil ve kural yazarken ayrımı gerekiyor.
  valueOp   String? // şifreli
  textValue String? // şifreli — sayı olmayan sonuç ("O Rh(+)")

  // PDF'in kendi sınıflaması. Laboratuvar bazı testlerde tek aralık yerine
  // kademe veriyor ("Optimum", "Sınırda yüksek", "Orta derecede risk") ve o
  // kademe tek bir alt/üst sınırdan daha çok şey söylüyor.
  pdfYorumu String? // "düşük" | "normal" | "yüksek" | "Orta derecede risk" ...
  pdfAralik String? // yorumun dayandığı aralık, olduğu gibi ("45-65", "<100")

  userId   Int
  user     User     @relation(fields: [userId], references: [id])
}

/// Güvenlik olayları — başarısız giriş, kilitlenme, geçersiz bilet vb.
///
/// NİYE VERİTABANINA DA YAZILIYOR: olaylar yalnızca konsola yazıldığında
/// hiçbir yere ulaşmıyordu. Render'ın günlükleri sınırlı süre tutuluyor,
/// aranabilir değil ve servis yeniden başlayınca akış kopuyor. Saldırı
/// olduğunu fark etmenin yolu yoktu.
///
/// IP ADRESİ DÜZ TUTULMUYOR: IP, KVKK ve GDPR açısından kişisel veri.
/// Saklanan değer HMAC-SHA256 özetinin ilk 16 hanesi. Bu, "aynı IP mi"
/// sorusunu cevaplıyor (saldırı tespiti için gereken tek şey bu) ama
/// özetten IP'ye geri dönülemiyor ve anahtar olmadan başka bir veri
/// kümesiyle eşleştirilemiyor.
///
/// SAKLAMA SÜRESİ SINIRLI: kayıtlar GUVENLIK_SAKLAMA_GUN (varsayılan 90)
/// gün sonra siliniyor — KVKK m.4'teki "ilgili olduğu amaç için gerekli
/// olan süre kadar" ilkesi.
model GuvenlikOlayi {
  id         Int      @id @default(autoincrement())
  olay       String   // "giriş başarısız", "HESAP KİLİTLENDİ" ...
  zaman      DateTime @default(now())
  ipOzeti    String?  // HMAC özeti, ham IP DEĞİL
  kullaniciId Int?    // ilişki kurulmuyor: kullanıcı silinse de olay kalmalı
  ayrinti    String?  // kişisel veri içermez; sayaç, sebep gibi bilgiler

  @@index([zaman])
  @@index([olay, zaman])
  @@index([kullaniciId, zaman])
}
