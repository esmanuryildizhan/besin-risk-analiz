# Üretim derlemesi ayarları (CRA bunu otomatik okuyor).
#
# INLINE_RUNTIME_CHUNK=false
# CRA varsayılan olarak webpack'in küçük "runtime" parçasını index.html'in
# İÇİNE satır içi <script> olarak gömüyor. Satır içi betik, katı bir
# Content-Security-Policy ile çalışmıyor: script-src 'self' onu engelliyor,
# çalıştırmak için ya 'unsafe-inline' (CSP'nin anlamını yok eder) ya da her
# derlemede değişen bir karma gerekiyor.
#
# Bu ayarla runtime ayrı bir dosyaya çıkıyor ve script-src 'self' yetiyor.
# Bedeli: bir ek istek (birkaç kB, aynı sunucudan).
INLINE_RUNTIME_CHUNK=false

# REACT_APP_SITE_URL
# Arayüzün KENDİ adresi. Bağlantı önizlemesi (Open Graph) etiketlerinde
# kullanılıyor: og:image ve og:url MUTLAK adres istiyor, göreli yol
# ("/logo512.png") ile sohbet uygulamaları görseli bulamıyor ve kart
# görselsiz çıkıyor.
#
# Burada varsayılan duruyor ki kimse bir ortam değişkeni eklemeyi unutunca
# önizleme sessizce bozulmasın. Vercel'de aynı adı taşıyan bir değişken
# tanımlanırsa O geçerli olur (ortam değişkeni dosyadan önce gelir).
#
# ALAN ADI DEĞİŞİRSE BURAYI DA DEĞİŞTİRİN.
REACT_APP_SITE_URL=https://besin-risk-analiz.vercel.app
